datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Transaction {
  id        Int      @id @default(autoincrement())
  date      String
  type      String
  amount    Int
  category  String
  memo      String?
  createdAt DateTime @default(now())
}
model Record {
  id        Int      @id @default(autoincrement())
  title     String
  amount    Int
  type      String   // "INCOME" (収入) または "EXPENSE" (支出)
  category  String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}